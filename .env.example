# --- Postgres on Neon ---
# Create a project at https://neon.tech, then copy both URLs from the dashboard.
# Use the pooled URL from the API and the direct URL from goose.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/crowdtune?sslmode=require
DATABASE_URL_DIRECT=postgres://USER:PASSWORD@ep-xxx.region.aws.neon.tech/crowdtune?sslmode=require

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8080
API_ENV=local
LOG_LEVEL=info

# --- Frontend ---
VITE_API_URL=http://localhost:8080

# --- Neon Auth (Phase 8 - leave blank until Phase 8 begins) ---
# Capture from Neon Console -> Auth -> Configuration after enabling Neon Auth.
NEON_AUTH_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=crowdtune
# Frontend mirror of NEON_AUTH_URL (Vite exposes only VITE_-prefixed vars).
VITE_NEON_AUTH_URL=
