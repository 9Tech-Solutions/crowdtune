{
  "name": "crowdtune",
  "version": "0.0.0",
  "private": true,
  "description": "Social jukebox monorepo (Go + React + Postgres)",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": "^24.11.0 || >=26.0.0",
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev:web": "bun run --filter web dev",
    "build:web": "bun run --filter web build",
    "lint:web": "bun run --filter web lint",
    "typecheck:web": "bun run --filter web typecheck",
    "test:web": "bun run --filter web test",
    "openapi:gen": "bun run --filter web openapi:gen",
    "check:web": "bun run --filter web check",
    "format:web": "bun run --filter web format"
  },
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/web"
  ],
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0"
  },
  "overrides": {
    "vite": "catalog:",
    "@babel/core@7": "^7.29.6",
    "baseline-browser-mapping@2": "^2.11.0",
    "brace-expansion@2": "^2.1.7",
    "browserslist@4": "^4.28.7",
    "js-yaml@4": "^4.3.2",
    "nanoid@5": "^5.1.16",
    "source-map-js@1": "^1.2.2"
  }
